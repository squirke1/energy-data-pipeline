# ENTSO-E API Configuration
ENTSOE_API_KEY=your_key_here

# Postgres (validated/transformed data, raw payloads, pipeline_runs) -
# defaults match docker-compose.yml. Port is 5433, not the Postgres default
# 5432, to avoid colliding with a native/other local Postgres install.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=energy_pipeline
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
# "prefer" is fine for local docker-compose (no SSL configured there). The
# scheduled production workflow (.github/workflows/scheduled-run.yml) sets
# this to "require" instead, since its managed Postgres is reachable over
# the internet.
POSTGRES_SSLMODE=prefer
