# ENTSO-E API Configuration
ENTSOE_API_KEY=your_key_here

# Postgres (validated/transformed data) - defaults match docker-compose.yml
# Port is 5433, not the Postgres default 5432, to avoid colliding with a
# native/other local Postgres install
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=energy_pipeline
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline

# MongoDB (raw ingested payloads) - defaults match docker-compose.yml
# Port is 27018, not the Mongo default 27017, for the same reason
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_DB=energy_pipeline
MONGO_USER=pipeline
MONGO_PASSWORD=pipeline
